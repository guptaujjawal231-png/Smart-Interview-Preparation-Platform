# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas or Local MongoDB)
# Format for MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.xyz.mongodb.net/ai_interview_prep?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/ai_interview_prep

# Authentication Security (JWT Secret)
JWT_SECRET=supersecretjwtkey_placement_ready_2026_change_in_production
JWT_EXPIRES_IN=7d

# Client URL (For CORS setup)
CLIENT_URL=http://localhost:5173

# AI Evaluation Engine
# Optional: Get free Gemini API key from Google AI Studio (https://aistudio.google.com/)
# If empty or invalid, the backend automatically uses the built-in Mock Evaluation Engine
GEMINI_API_KEY=mock
